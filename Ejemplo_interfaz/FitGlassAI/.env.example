# Configuración de Inteligencia Artificial: "gemini" o "openai"
AI_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# OpenAI GPT (soporta gpt-4o, gpt-4o-mini con visión)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Replicate & Tripo3D
REPLICATE_API_TOKEN=
TRIPO_API_KEY=

# Red y Seguridad
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Opcional: token de ngrok para túnel del backend
NGROK_AUTHTOKEN=

# Solo desarrollo (dejar vacío en producción)
# ENABLE_DEMO_USER=1            -> crea demo@vitra.ai / password123
# ALLOW_INSECURE_DEV_RESET=1    -> permite /reset-password sin token
