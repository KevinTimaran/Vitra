# Copia este archivo a .env y añade las claves de los servicios que vayas a utilizar.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
REPLICATE_API_TOKEN=
TRIPO_API_KEY=
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Opcional: token personal de ngrok si habilitas el túnel del backend.
NGROK_AUTHTOKEN=
